{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm",
    "analytics": "c48a71be-0e9c-4709-9c8d-352c91ca1c90"
  },
  "newProjectRoot": "projects",
  "projects": {
    "gpi-tracker-ui": {
      "projectType": "application",
      "schematics": {},
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "assets": [
  {
    "glob": "**/*",
    "input": "public"
  },
  {
    "glob": "silent-check-sso.html",
    "input": "src",
    "output": "/"
  }
],
"styles": [
  "node_modules/primeicons/primeicons.css",
  "src/styles.css"
],
            "outputMode": "static",
            "security": {
              "allowedHosts": []
            }
           
            
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kB",
                  "maximumError": "8kB"
                }
              ],
              "outputHashing": "all",
              "serviceWorker": "ngsw-config.json"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "gpi-tracker-ui:build:production"
            },
            "development": {
              "buildTarget": "gpi-tracker-ui:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:unit-test"
        }
      }
    }
  }
}
